{
  "version": 4,
  "configurations": [
    {
      "name": "Win32",
      "includePath": [
        "${workspaceFolder}/src/**",
        "${workspaceFolder}/libraries/raylib",
        "${workspaceFolder}/libraries/**"
      ],
      "cStandard": "c17",
      "cppStandard": "c++20",
      "defines": ["DEBUG", "NOMINMAX", "PLATFORM_DESKTOP", "GRAPHICS_API_OPENGL_33"],
      // No compilerPath: the extension finds the newest MSVC and Windows SDK
      // itself, as fastbuild/build.cmd does for the build. (Setting it to ""
      // would instead tell it to use no compiler at all.)
      "intelliSenseMode": "windows-msvc-x64"
    }
  ]
}
