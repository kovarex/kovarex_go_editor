// Go Editor build, for FASTBuild. Run it through build.cmd, which finds the
// compiler first:
//   fastbuild\build.cmd Debug      Debug build
//   fastbuild\build.cmd Release    Release build
//   fastbuild\build.cmd            both (the default target, 'all')
//   fastbuild\build.cmd solution   Visual Studio solution, GoEditor.sln
//   add -clean to rebuild from scratch
// The exe lands at build/<Config>/goeditor.exe.

//------------------------------------------------------------------------------
// Toolchain. build.cmd finds the newest MSVC and Windows SDK with vswhere and
// passes them in the variables a Visual Studio developer prompt sets, so from
// one of those FBuild.exe can be run directly, from the repo root:
//   fastbuild\FBuild.exe -config fastbuild\fbuild.bff Debug
// Anywhere else, "Could not import environment variable" means use build.cmd.
// Each ends in a backslash, as the developer prompt has them.
//------------------------------------------------------------------------------
#import VCToolsInstallDir
#import WindowsSdkDir
#import WindowsSDKVersion

.VSBin = '$VCToolsInstallDir$bin\Hostx64\x64'
.SDKInclude = '$WindowsSdkDir$Include\$WindowsSDKVersion$'
.SDKLib     = '$WindowsSdkDir$Lib\$WindowsSDKVersion$'

#import TMP
#import SystemRoot

// What vcvars would set up: FASTBuild runs every tool in this environment
// rather than the calling shell's, so the build works from any prompt.
Settings
{
  .Environment =
  {
    'PATH=$VSBin$;$SystemRoot$\System32'
    'TMP=$TMP$'
    'SystemRoot=$SystemRoot$'
    'INCLUDE=$VCToolsInstallDir$include;$SDKInclude$ucrt;$SDKInclude$um;$SDKInclude$shared'
    'LIB=$VCToolsInstallDir$lib\x64;$SDKLib$ucrt\x64;$SDKLib$um\x64'
  }
}

Compiler( 'MSVC' )
{
  .Executable = '$VSBin$\cl.exe'
}

.Compiler          = 'MSVC'
.Librarian         = '$VSBin$\lib.exe'
.LibrarianOptions  = '/NOLOGO /MACHINE:X64 /OUT:"%2" "%1"'
.Linker            = '$VSBin$\link.exe'

// /Z7 keeps debug info in each .obj, so files compile in parallel without
// fighting over a shared .pdb; the linker still writes one goeditor.pdb.
//
// /Gy and /Gw put each function and each piece of global data in its own COMDAT,
// which is what lets the linker's /OPT:REF throw away the ones nothing calls.
// Without them the whole of raylib and Agui ends up in the exe whether the game
// touches it or not -- with them, dropping raylib's unused modules by hand buys
// nothing, because the linker has already dropped them.
.BaseCompilerOptions = '"%1" /Fo"%2" /c /nologo /Z7 /Gy /Gw /utf-8 /DWIN32 /D_WINDOWS /external:env:INCLUDE /external:W0'
.CppOptions          = ' /std:c++20 /EHsc /GR /permissive-'

// Link the C/C++ runtime statically (into raylib and Agui too, so everything
// agrees), so the exe runs on a machine without the Visual C++
// Redistributable -- or, for a Debug build, without Visual Studio.
.Debug =
[
    .Config        = 'Debug'
    .ConfigOptions = ' /Od /Ob0 /RTC1 /MTd /D_DEBUG'
                   // Agui keeps extra debug bookkeeping in its classes under
                   // DEBUG, so every user of its headers has to agree on it.
                   + ' /DDEBUG'
    .ConfigLinkerOptions = ''
    // A console, for raylib's log.
    .Subsystem     = ' /SUBSYSTEM:CONSOLE'
]
// Release is built for size rather than speed: /O1 over /O2, and whole-program
// optimisation (/GL with the linker's /LTCG) on top. Nothing here is hot -- the
// editor spends its time waiting for a click -- so the ~400 KB is free.
// The C runtime is still linked statically (/MT, below), which costs about
// 330 KB; /MD would save it, at the price of needing the Visual C++
// Redistributable on whatever machine the exe is run on.
.Release =
[
    .Config        = 'Release'
    .ConfigOptions = ' /O1 /Ob1 /MT /DNDEBUG /GL'
    .ConfigLinkerOptions = ' /OPT:REF /OPT:ICF /LTCG'
    // A window and no console, so double-clicking a .sgf file doesn't flash a
    // black box up behind the editor. main() is still the entry point.
    .Subsystem     = ' /SUBSYSTEM:WINDOWS /ENTRY:mainCRTStartup'
]

//------------------------------------------------------------------------------
// The GUI atlas is compiled into the exe, so the exe is all there is to ship.
// tools/Embed.cpp turns the .png into a .cpp of bytes. (The stones and marks
// need no file: ui/GoSprites.cpp paints them at start-up.)
//------------------------------------------------------------------------------
ObjectList( 'Embed-Obj' )
{
  .CompilerOptions    = .BaseCompilerOptions + .CppOptions + ' /O2 /MT /W4'
  .CompilerInputFiles = { 'tools\Embed.cpp' }
  .CompilerOutputPath = 'build\tools\'
}
Executable( 'Embed' )
{
  .Libraries     = { 'Embed-Obj' }
  .LinkerOutput  = 'build\tools\Embed.exe'
  .LinkerOptions = '/NOLOGO /MACHINE:X64 /SUBSYSTEM:CONSOLE /OUT:"%2" "%1"'
}
Exec( 'GuiAtlas' )
{
  .ExecExecutable = 'build\tools\Embed.exe'
  .ExecInput      = 'src\ui\gui.png'
  .ExecOutput     = 'build\generated\GuiAtlas.cpp'
  .ExecArguments  = '"%1" "%2" GUI_ATLAS_PNG ui'
}

// The typeface too: Titillium Web, the one Factorio's GUI is set in (SIL Open
// Font License, src/ui/fonts/OFL.txt). See ui/Fonts.cpp.
Exec( 'FontRegular' )
{
  .ExecExecutable = 'build\tools\Embed.exe'
  .ExecInput      = 'src\ui\fonts\TitilliumWeb-Regular.ttf'
  .ExecOutput     = 'build\generated\FontRegular.cpp'
  .ExecArguments  = '"%1" "%2" FONT_REGULAR_TTF ui'
}
Exec( 'FontSemiBold' )
{
  .ExecExecutable = 'build\tools\Embed.exe'
  .ExecInput      = 'src\ui\fonts\TitilliumWeb-SemiBold.ttf'
  .ExecOutput     = 'build\generated\FontSemiBold.cpp'
  .ExecArguments  = '"%1" "%2" FONT_SEMIBOLD_TTF ui'
}
Exec( 'FontBold' )
{
  .ExecExecutable = 'build\tools\Embed.exe'
  .ExecInput      = 'src\ui\fonts\TitilliumWeb-Bold.ttf'
  .ExecOutput     = 'build\generated\FontBold.cpp'
  .ExecArguments  = '"%1" "%2" FONT_BOLD_TTF ui'
}

// Agui is a pile of small files that rarely change: compile it as a few
// unity blobs instead of ~100 separate translation units.
Unity( 'Agui-Unity' )
{
  .UnityInputPath  = 'libraries\Agui\'
  .UnityOutputPath = 'build\unity\agui\'
  .UnityNumFiles   = 8
}

//------------------------------------------------------------------------------
// Per-config targets.
//------------------------------------------------------------------------------
.Configs = { .Debug, .Release }
ForEach( .Cfg in .Configs )
{
  Using( .Cfg )
  .Out = 'build\$Config$'

  // raylib 5.5, vendored in libraries/raylib (desktop GLFW / OpenGL 3.3).
  .RaylibDefines = ' /DPLATFORM_DESKTOP /DGRAPHICS_API_OPENGL_33 /D_CRT_SECURE_NO_WARNINGS'
  Library( 'raylib-$Config$' )
  {
    .CompilerOptions    = .BaseCompilerOptions + .ConfigOptions + .RaylibDefines
                        + ' /W0 /I"libraries\raylib" /I"libraries\raylib\external\glfw\include"'
    .CompilerInputPath  = 'libraries\raylib\'
    .CompilerInputPathRecurse = false
    .CompilerInputPattern = '*.c'
    .CompilerOutputPath = '$Out$\obj\raylib\'
    .LibrarianOutput    = '$Out$\lib\raylib.lib'
  }

  // Agui: vendored GUI library, included as <Agui/...>. It has no backend of
  // its own; the game supplies a raylib one in src/ui.
  .AguiDefines = ' /DNOMINMAX /D_CRT_SECURE_NO_WARNINGS'
  Library( 'agui-$Config$' )
  {
    .CompilerOptions    = .BaseCompilerOptions + .CppOptions + .ConfigOptions + .AguiDefines
                        + ' /W0 /bigobj /I"libraries"'
                        // The STL raises its own headers back to /W3, so /W0 alone
                        // doesn't hide Agui's double->float emplace_back in Graph.cpp.
                        + ' /wd4244'
    .CompilerInputUnity = { 'Agui-Unity' }
    .CompilerOutputPath = '$Out$\obj\agui\'
    .LibrarianOutput    = '$Out$\lib\agui.lib'
  }

  // The editor. It sees GLFW's header as well as raylib's, for the one thing
  // raylib can't do: take back a click on the close button (see app/App.cpp).
  ObjectList( 'goeditor-obj-$Config$' )
  {
    .CompilerOptions    = .BaseCompilerOptions + .CppOptions + .ConfigOptions + .RaylibDefines + .AguiDefines
                        + ' /W4 /I"src" /external:I"libraries" /external:I"libraries\raylib"'
                        + ' /external:I"libraries\raylib\external\glfw\include"'
    .CompilerInputPath  = 'src\'
    .CompilerInputPattern = '*.cpp'
    .CompilerInputFiles = { 'build\generated\GuiAtlas.cpp', 'build\generated\FontRegular.cpp',
                            'build\generated\FontSemiBold.cpp', 'build\generated\FontBold.cpp' }
    .CompilerOutputPath = '$Out$\obj\goeditor\'
    .PreBuildDependencies = { 'GuiAtlas', 'FontRegular', 'FontSemiBold', 'FontBold' }
  }

  Executable( 'goeditor-$Config$' )
  {
    .Libraries     = { 'goeditor-obj-$Config$', 'raylib-$Config$', 'agui-$Config$' }
    .LinkerOutput  = '$Out$\goeditor.exe'
    .LinkerOptions = '/NOLOGO /MACHINE:X64 /DEBUG /INCREMENTAL:NO /OUT:"%2" "%1"'
                   + .Subsystem
                   + .ConfigLinkerOptions
                   // advapi32 for the registry (the .sgf association), ole32
                   // for the Documents folder's path.
                   + ' opengl32.lib gdi32.lib winmm.lib user32.lib shell32.lib kernel32.lib advapi32.lib ole32.lib'
  }

  Alias( '$Config$' ) { .Targets = { 'goeditor-$Config$' } }
}

Alias( 'all' ) { .Targets = { 'Debug', 'Release' } }

//------------------------------------------------------------------------------
// Visual Studio solution, for opening the project in the IDE:
//   fastbuild\build.cmd solution
// writes GoEditor.sln at the repo root (with its project in build\vs\).
// It's a Makefile project: Build and Rebuild in VS run build.cmd, so FASTBuild
// still does the building, and F5 starts goeditor.exe under the debugger.
// IntelliSense's include paths and defines come from each config's .Target.
//------------------------------------------------------------------------------
.VSConfigs = {}
ForEach( .Cfg in .Configs )
{
  Using( .Cfg )
  .VSConfig =
  [
    .Platform              = 'x64'
    .Config                = '$Config$'
    .Target                = 'goeditor-$Config$'
    .PlatformToolset       = 'v143'
    .ProjectBuildCommand   = '"^$(SolutionDir)fastbuild\build.cmd" -ide $Config$'
    .ProjectRebuildCommand = '"^$(SolutionDir)fastbuild\build.cmd" -ide -clean $Config$'
    .LocalDebuggerWorkingDirectory = '^$(SolutionDir)'
    .AdditionalOptions     = '/std:c++20'
  ]
  ^VSConfigs + .VSConfig
}

VCXProject( 'goeditor-proj' )
{
  .ProjectOutput     = 'build\vs\goeditor.vcxproj'
  .ProjectInputPaths = { 'src\', 'tools\' }
  .ProjectFiles      = { 'fastbuild\fbuild.bff', 'fastbuild\build.cmd' }
  .ProjectBasePath   = { 'src\', '.\' }
  .ProjectConfigs    = .VSConfigs
}

VSSolution( 'solution' )
{
  .SolutionOutput       = 'GoEditor.sln'
  .SolutionProjects     = { 'goeditor-proj' }
  .SolutionBuildProject = 'goeditor-proj'
  .SolutionConfigs      = .VSConfigs
  .SolutionVisualStudioVersion        = '17.0.31903.59'
  .SolutionMinimumVisualStudioVersion = '10.0.40219.1'
}
